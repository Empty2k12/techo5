# TECHO5 root filesystem: busybox init.
#
# boot.sh brings the device up (devices, network, clock, SSH, slot trial);
# techo5-run is the daemon, restarted whenever it exits — after installing an
# update on purpose, or after a crash; techo5-console is the root shell on the
# USB serial port.
::sysinit:/etc/techo5/boot.sh
::respawn:/usr/local/sbin/techo5-run
::respawn:/usr/local/sbin/techo5-console
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/techo5/shutdown.sh

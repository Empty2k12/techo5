#!/bin/sh
# TECHO5 first-boot init for the Linux image (porting plan M4, step 1).
#
# Runs as PID 1 from the initramfs on the LineageOS 4.9 kernel. It does the
# minimum: populate /dev (the kernel has no devtmpfs), clear the recovery
# bootloader message so the next reboot is a normal Android boot, keep a boot
# log on the userdata partition where Android can read it afterwards, paint
# the panel, offer a root shell over USB serial (CDC ACM), try the vendor
# Wi-Fi module, and reboot into Android on its own after a while unless told
# to stay. Everything is best effort and logged; nothing here is permanent.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
STAY_MINUTES=${STAY_MINUTES:-15}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /dev
mkdir -p /dev/pts /dev/graphics /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mdev -s
[ -e /dev/fb0 ] && ln -sf /dev/fb0 /dev/graphics/fb0
echo 4 4 1 7 > /proc/sys/kernel/printk

log() { echo "techo5-init: $*" | tee /dev/kmsg >> /tmp/boot.log 2>/dev/null; }
log "TECHO5 Linux init starting, kernel $(uname -r) $(uname -m)"

# --- Recovery bootloader message: clear it first, so a crash later still
# leaves the unit booting Android next time. Android writes "boot-recovery"
# into the first 32 bytes of MISC for `reboot recovery`; recovery zeroes it.
MISC=/dev/mmcblk0p8
if [ -e "$MISC" ]; then
	dd if=/dev/zero of=$MISC bs=32 count=1 conv=notrunc 2>/dev/null && log "cleared bootloader message in MISC"
else
	log "no $MISC node; bootloader message not cleared"
fi

# --- Persistent log on userdata (ext4, the Android /data partition).
mkdir -p /data /android
if mount -t ext4 -o noatime /dev/mmcblk0p16 /data 2>/dev/null; then
	mkdir -p /data/techo5-linux
	LOGDIR=/data/techo5-linux
	log "userdata mounted, logging to $LOGDIR"
else
	LOGDIR=/tmp
	log "userdata mount failed, logging to tmp only"
fi
mount -t ext4 -o ro,noatime /dev/mmcblk0p12 /android 2>/dev/null && log "android system mounted read-only at /android"
[ -d /android/system/vendor ] && ln -sfn /android/system/vendor /vendor

snapshot() {
	{
		echo "=== $(date) uptime $(cut -d' ' -f1 /proc/uptime)"
		cat /tmp/boot.log
		echo "--- dmesg tail"; dmesg | tail -40
		echo "--- ip link"; ip link 2>&1
		echo "--- fb"; cat /sys/class/graphics/fb0/virtual_size 2>&1
		echo "--- udc"; ls /sys/class/udc 2>&1; cat /sys/kernel/config/usb_gadget/g1/UDC 2>&1
		echo "--- mounts"; cat /proc/mounts
		echo "--- mem"; head -3 /proc/meminfo
	} > $LOGDIR/boot.log.new 2>&1 && mv $LOGDIR/boot.log.new $LOGDIR/boot.log
	sync
}
snapshot

# --- Panel: paint the test screen with the clock ticking, as proof of life.
if [ -x /usr/local/bin/fbprobe ]; then
	/usr/local/bin/fbprobe -hold ${STAY_MINUTES}m > /tmp/fbprobe.log 2>&1 &
	log "fbprobe started"
fi

# --- USB gadget: one CDC ACM serial function, root shell on it.
if mount -t configfs none /sys/kernel/config 2>/dev/null; then
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p $G && cd $G || true
	echo 0x1d6b > idVendor
	echo 0x0104 > idProduct
	echo 0x0200 > bcdUSB
	mkdir -p strings/0x409
	echo "TECHO5" > strings/0x409/manufacturer
	echo "Echo Show 5 Linux" > strings/0x409/product
	echo "$(cat /proc/device-tree/serial-number 2>/dev/null || echo techo5)" > strings/0x409/serialnumber
	mkdir -p configs/c.1/strings/0x409
	echo "acm" > configs/c.1/strings/0x409/configuration
	mkdir -p functions/acm.usb0
	ln -sf $G/functions/acm.usb0 configs/c.1/acm.usb0
	UDC=$(ls /sys/class/udc | head -1)
	if [ -n "$UDC" ]; then
		echo "$UDC" > UDC && log "usb gadget bound to $UDC (acm)"
	else
		log "no UDC found; usb gadget not started"
	fi
	cd /
	(
		while true; do
			if [ -e /dev/ttyGS0 ]; then
				setsid sh -c 'exec sh -l < /dev/ttyGS0 > /dev/ttyGS0 2>&1'
			fi
			sleep 2
		done
	) &
else
	log "configfs mount failed; no usb serial"
fi

# --- Wi-Fi: load the vendor module from the Android system partition.
# firmware_class.path=/vendor/firmware comes from the boot image command line.
WLAN=/android/system/vendor/lib/modules/mt76x8_wlan.ko
if [ -e "$WLAN" ]; then
	if insmod $WLAN 2>/tmp/insmod.err; then
		log "mt76x8_wlan loaded"
		sleep 5
		ip link show wlan0 >/dev/null 2>&1 && log "wlan0 present" || log "wlan0 not present after insmod"
	else
		log "insmod mt76x8_wlan failed: $(cat /tmp/insmod.err)"
	fi
else
	log "vendor wlan module not found at $WLAN"
fi

snapshot
log "ready; touch /tmp/stay on the serial shell to cancel the ${STAY_MINUTES}-minute reboot"

# --- Keep logging, then reboot into Android unless asked to stay.
i=0
while true; do
	sleep 30
	i=$((i+1))
	snapshot
	if [ -e /tmp/stay ]; then continue; fi
	if [ $((i*30)) -ge $((STAY_MINUTES*60)) ]; then
		log "time is up, rebooting into Android"
		snapshot
		umount /android 2>/dev/null
		umount /data 2>/dev/null
		sync
		reboot -f
	fi
done
